{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NADT",
  "version": "0.1.2",
  "identifier": "com.nadt.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../data/NADT.png",
      "../data/NADT.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
